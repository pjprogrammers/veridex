# VERIDEX Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=veridex
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database override: unset to use PostgreSQL below. Set to run standalone,
# e.g. DATABASE_URL=sqlite+aiosqlite:///./veridex.db (see "make seed-local").
# DATABASE_URL=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veridex
POSTGRES_USER=veridex
POSTGRES_PASSWORD=veridex_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MinIO/S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=veridex_minio
MINIO_SECRET_KEY=veridex_minio_secret
MINIO_BUCKET=veridex-documents
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/tiff,application/pdf

# OCR
OCR_ENGINE=paddleocr

# Face Verification
FACE_MODEL_NAME=arcface_r100_v1
FACE_SIMILARITY_THRESHOLD=0.4

# Risk Scoring
RISK_HIGH_THRESHOLD=0.7
RISK_MEDIUM_THRESHOLD=0.4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
